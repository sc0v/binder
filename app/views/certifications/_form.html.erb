<% current_certs =
     @participant.certifications.map { |cert| cert.certification_type.name } %>
<%= simple_form_for [@participant, @certification],
                    html: {
                      class: 'form-horizontal'
                    } do |f| %>
  <div class="form-inputs">
    <%= f.association :certification_type,
                      collection:
                        CertificationType.all.select { |c|
                          current_certs.exclude?(c.name)
                        } %>
    <%= f.input :participant_id, as: :hidden %>
  </div>
  <div class="cmu-button-note">
    <%= f.button :submit, class: 'btn' %>
    <%= link_to t('.cancel', default: t('helpers.links.cancel')),
                @participant,
                class: 'btn ghost' %>
  </div>
<% end %>
