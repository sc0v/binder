<% update_document_title(add: 'Downtime') %>
<% update_breadcrumbs(add: 'Downtime') %>
<% nav %>

<div class="content">
  <div>
    <h1>Downtime</h1>
    <div class="table-scroll">
      <table class="alternate cmu-full">
        <thead>
          <tr>
            <th><%= 'Organization' %></th>
            <th><%= 'Organization Category' %></th>
            <th class="alignright">Taken</th>
            <th class="alignright">Remaining</th>
          </tr>
        </thead>
        <tbody>
          <% Organization.ordered_by_name.each do |organization| %>
            <tr
              class="<%= 'danger' if organization.remaining_downtime.negative? %>"
            >
              <td
                ><%= link_to organization.name, organization_downtime_index_path(organization) %></td
              >
              <td><%= organization.organization_category.name %></td>
              <td class="alignright"
                ><%= format_duration(organization.downtime) %></td
              >
              <td class="alignright"
                ><%= format_duration(organization.remaining_downtime) %></td
              >
            </tr>
          <% end %>
        </tbody>
      </table>
    </div> </div
  ><div class="sidebar">
    <% if can?(:create, OrganizationTimelineEntry, entry_type: 'downtime') %>
      <%= render partial: 'downtime_sidebar' %>
    <% end %>
  </div>
</div>
