<div class="content wide">
  <div>
    <h1>Event Types</h1>
    <div class="table-scroll">
      <table class="alternate cmu-full">
        <thead>
          <tr>
            <th>Name</th>
            <th>Display in Sidebar</th>
            <th colspan="3"></th>
          </tr>
        </thead>
        <tbody>
          <% @event_types.each do |event_type| %>
            <tr>
              <td><%= event_type.name %></td>
              <td><%= event_type.display ? 'Yes' : 'No' %></td>
              <td>
                <% if can?(:edit, EventType) %>
                  <%= link_to 'Edit', edit_event_type_path(event_type), class: 'btn small' %>
                <% end %>
                <% if can?(:destroy, EventType) %>
                  <%= link_to 'Delete',
                              event_type,
                              method: :delete,
                              data: {
                                confirm: 'Are you sure?'
                              },
                              class: 'btn small' %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <br />
    <%= link_to 'New Event Type', new_event_type_path, class: 'btn' %>
  </div>
</div>
