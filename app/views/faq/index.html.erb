<% update_document_title(add: 'Frequently Asked Questions') %>
<% update_breadcrumbs(add: 'FAQ') %>
<%# One section for each category; the first also holds the sidebar %>
<% @category_faq.each_with_index do |(category, questions), index| %>
  <div class="content">
    <div>
      <h1
        ><span class="rule-bottom"
          ><%= category.blank? ? t('.general') : category.name %></span
        ></h1
      >
      <% questions.each do |faq| %>
        <h2 class="collapsed" id="<%= dom_id(faq) %>"><%= faq.question %></h2>
        <div>
          <%= simple_format(faq.answer) %>
          <% if can?(:update, faq) || can?(:destroy, faq) %>
            <p>
              <% if can?(:update, faq) %>
                <%= link_to t('.edit'), edit_faq_path(faq) %>
              <% end %>
              <% if can?(:update, faq) && can?(:destroy, faq) %>
                |
              <% end %>
              <% if can?(:destroy, faq) %>
                <%= button_tag t('.destroy'),
                               type: 'submit',
                               form: dom_id(faq, :delete),
                               class: 'cmu-link-button' %>
              <% end %>
            </p>
            <% if can?(:destroy, faq) %>
              <%= form_with url: faq_path(faq),
                            method: :delete,
                            id: dom_id(faq, :delete),
                            data: {
                              turbo_confirm: t('.confirm')
                            } do %>

              <% end %>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div
    ><%= render 'sidebar' if index.zero? %>
  </div>
<% end %>
<% if @category_faq.empty? %>
  <div class="content">
    <div>
      <h1><%= t('.heading') %></h1>
      <p><%= t('.empty') %></p>
    </div
    ><%= render 'sidebar' %>
  </div>
<% end %>
