<div class="content wide">
  <div>
    <%- model_class = Organization -%>
    <div class="page-header">
      <h1>Charges</h1>
    </div>
    <div class="table-scroll">
      <table class="alternate cmu-full">
        <thead>
          <tr>
            <th><%= model_class.human_attribute_name(:name) %></th>
            <th
              ><%= model_class.human_attribute_name(:organization_category) %></th
            >
            <th class="alignright">Approved</th>
            <th class="alignright">Pending</th>
            <th class="alignright">Total</th>
          </tr>
        </thead>
        <tbody>
          <% @organizations.each do |organization| %>
            <tr>
              <td
                ><%= link_to organization.short_name, organization_path(organization) %></td
              >
              <td><%= organization.organization_category.name %></td>
              <td class="alignright"
                ><%= organization.charges.approved.sum('amount') %></td
              >
              <td class="alignright"
                ><%= organization.charges.pending.sum('amount') %></td
              >
              <td class="alignright"
                ><%= organization.charges.sum('amount') %></td
              >
            </tr>
          <% end %>
          <tr>
            <td colspan="2"><b>Total:</b></td>
            <td class="alignright"><%= @approved_total %></td>
            <td class="alignright"><%= @pending_total %></td>
            <td class="alignright"><%= @total %></td>
          </tr></tbody
        >
      </table>
    </div>
    <br />
    <br />
    <div class="table-scroll">
      <table class="alternate cmu-full">
        <thead>
          <tr>
            <th><%= model_class.human_attribute_name(:name) %></th>
            <th class="alignright">Approved</th>
            <th class="alignright">Pending</th>
            <th class="alignright">Total</th>
          </tr>
        </thead>
        <tbody>
          <% @charge_types.each do |type| %>
            <tr>
              <td><%= type.name %></td>
              <td class="alignright"
                ><%= type.charges.approved.sum('amount') %></td
              >
              <td class="alignright"
                ><%= type.charges.pending.sum('amount') %></td
              >
              <td class="alignright"><%= type.charges.sum('amount') %></td>
            </tr>
          <% end %>
          <tr>
            <td><b>Total:</b></td>
            <td class="alignright"><%= @approved_total %></td>
            <td class="alignright"><%= @pending_total %></td>
            <td class="alignright"><%= @total %></td>
          </tr></tbody
        >
      </table>
    </div>
  </div>
</div>
