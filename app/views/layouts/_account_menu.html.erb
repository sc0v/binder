<%# locals: (user:) -%>
<%# First in the menu: the signed-in user's name, Profile and Sign Out, or
    Sign In. The template shows li.secondary only in the menu. %>
<li class="secondary cmu-account-menu">
  <% if user %>
    <a class="cmu-account-name"
      ><%= render 'layouts/initials', name: user.name %><%= user.name %></a
    >
    <%= link_to 'Profile', profile_path %>
    <%= link_to 'Sign Out', logout_path %>
  <% else %>
    <%= button_to 'Sign In',
                  login_path,
                  class: 'btn ghost small',
                  form: {
                    data: {
                      turbo: false
                    }
                  } %>
  <% end %>
</li>
