<%# locals: (user:, items:, current:) -%>
<%# The footer: the app's name and address, then the navigation in the third
    column, where the template's script finds it %>
<footer class="grid column3 invert">
  <div>
    <p>
      Spring Carnival Binder<br />
      Spring Carnival Committee<br />
      Carnegie Mellon University<br />
      Cohon University Center, Office 310<br />
      5000 Forbes Avenue<br />
      Pittsburgh, PA 15213<br />
      412-268-5226
    </p>
    <ul>
      <li>
        <%= link_to 'systems@springcarnival.org', contact_email_url %>
      </li>
      <li><a href="https://www.cmu.edu/legal/">Legal Info</a></li>
      <li><a href="https://www.cmu.edu/">www.cmu.edu</a></li>
    </ul>
    <ul>
      <li>&copy; <%= Time.zone.today.year %> Carnegie Mellon University</li>
    </ul>
  </div>
  <div></div>
  <div>
    <%= render 'layouts/navigation', user:, items:, current: %>
  </div>
</footer>
