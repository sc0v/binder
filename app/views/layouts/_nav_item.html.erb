<%# locals: (item:, current:) -%>
<%# One item and its sub-list. active marks the current item; the template
    marks the items above it. %>
<%= tag.li class: { secondary: item.secondary, active: item.key == current } do %>
  <%= link_to item.label,
              item.url,
              aria: {
                current: ('page' if current_page?(item.url))
              } %>
  <% if item.children.any? %>
    <ul>
      <%= render partial: 'layouts/nav_item',
                 collection: item.children,
                 as: :item,
                 locals: {
                   current:
                 } %>
    </ul>
  <% end %>
<% end %>
