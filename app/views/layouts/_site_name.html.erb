<%# The site name, with Spring Carnival's logo beside it. The logo's link has
    to touch the closing </div>, or it drops below the name. %>
<div id="sitename">
  <div>
    <span class="sitetitle"
      ><%= link_to 'Spring Carnival Binder', root_path %></span
    >
    <h2>The booth and operations management application</h2>
  </div><%= link_to image_tag('scc-logo.png', alt: 'Spring Carnival'),
              spring_carnival_url,
              id: 'sccWordmarkLink' %>
</div>
