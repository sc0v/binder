<!DOCTYPE html>
<%# The Carnegie Mellon Web Kilt's page (layout.html#skeleton): CMU's template,
    the kit, then Binder's own styles; the navigation in the footer, which the
    template's script copies into the header tabs and the menu. %>
<% user = Current.user %>
<% items = nav_items %>
<html lang="en">
  <head>
    <%= render 'layouts/head' %>
  </head>
  <%= tag.body class: ['no-js', 'cmu-app', { 'cmu-acting-as': Current.imposter }],
               data: { cmu_menu: 'closed' } do %>
    <div id="container">
      <header>
        <%= render 'layouts/site_bars', user: %>
        <%= render 'layouts/roof', user: %>
        <%= render 'layouts/site_name' %>
      </header>
      <main id="content">
        <%= render 'layouts/breadcrumbs', trail: breadcrumbs %>
        <%= render 'layouts/flash', messages: flash %>
        <%= yield %>
      </main>
      <%= render 'layouts/footer', user:, items:, current: nav_current(items) %>
    </div>
    <%= render 'layouts/acting_bar', user: user if Current.imposter %>
    <%= render 'layouts/nfc_fab' if user&.scc? %>
    <%= render 'layouts/template_scripts' %>
  <% end %>
</html>
