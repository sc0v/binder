<div class="cmu-note">
  <div class="build-step-row">
    <div>
      <%= link_to step.title, [@organization, @build_status, step] %>
      <% if step.approver.present? %>
        <div class="cmu-hint">
          Approved by <%= step.approver.send(:cached_name) %>
          <% if step.approved_at.present? %>
            · <%= step.approved_at.strftime('%b %-d at %-l:%M %p') %>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="cmu-button-note">
      <% if step.approver.present? %>
        <span class="cmu-pill cmu-pill--green">Approved</span>
      <% else %>
        <span class="cmu-pill cmu-pill--amber">Not Approved</span>
      <% end %>

      <% if can?(:update, step) %>
        <%= form_with model: [@organization, @build_status, step] do |f| %>
          <%= hidden_field_tag 'update_type', :enabled %>
          <%= hidden_field_tag 'url', request.original_fullpath %>
          <%= f.button step.is_enabled ? 'Disable' : 'Enable', class: 'btn ghost small' %>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
