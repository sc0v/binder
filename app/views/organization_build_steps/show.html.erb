<% update_document_title(add: 'Organizations') %>
<% update_breadcrumbs(add: link_to('Organizations', organizations_path)) %>
<% update_breadcrumbs(
     add: link_to(@organization.name, organization_path(@organization))
   ) %>
<% update_breadcrumbs(
     add: link_to("#{@status_name} Progress", [@organization, @build_status])
   ) %>
<% update_breadcrumbs(add: @build_step.title) %>

<div class="content">
  <div>
    <h1><%= @build_step.title %></h1>
    <div style="margin-bottom: 2em">
      <turbo-frame id="requirements_frame">
        <h2>Requirements</h2>
        <% if @requirements %>
          <div class="cmu-note"> <%= @requirements %> </div>
        <% elsif cannot?(:update, @build_step) %>
          <p>No requirements listed.</p>
        <% end %>
        <% if can?(:update, @build_step) %>
          <p>
            <%= link_to @requirements ? 'Edit Requirements' : 'Add Requirements',
                        [:edit, @organization, @build_status, @build_step],
                        class: 'btn ghost small' %>
          </p>
        <% end %>
      </turbo-frame>
    </div>

    <% if can?(:update, @build_step) %>
      <turbo-frame id="internal_notes_frame">
        <h2>Internal Notes</h2>
        <% if @internal_notes %>
          <div class="cmu-note"> <%= @internal_notes %> </div>
        <% end %>
        <p>
          <%= link_to @internal_notes ? 'Edit Internal Notes' : 'Add Internal Notes',
                      [:edit, @organization, @build_status, @build_step],
                      class: 'btn ghost small' %>
        </p>
      </turbo-frame>
    <% end %> </div
  ><div class="sidebar">
    <% if @build_step.approver.present? %>
      <p class="cmu-pill cmu-pill--green"> Approved </p>
      by <b><%= @build_step.approver.name %></b><br />
      <% if @build_step.approved_at.present? %>
        on <b><%= @build_step.approved_at.strftime('%b %e at %l:%M %p') %></b
        ><br />
      <% end %>
    <% else %>
      <p class="cmu-pill cmu-pill--amber"> Not Approved </p>
    <% end %>
    <% if can?(:update, OrganizationBuildStep) %>
      <br />
      <%= form_with model: [@organization, @build_status, @build_step] do |f| %>
        <%= hidden_field_tag 'update_type', :approved %>
        <%= hidden_field_tag 'url', request.original_fullpath %>
        <%= hidden_field_tag 'approver', Current.user.id %>
        <% if @build_step.approver.present? %>
          <%= f.submit 'Unapprove', class: 'btn' %>
        <% else %>
          <%= f.submit 'Approve', class: 'btn' %>
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>
