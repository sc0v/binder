<!-- Breadcrumb and Nav Depend on Route (from organization vs. from participant) -->
<% if @organization %>
  <% update_document_title(add: 'Organizations') %>
  <% update_breadcrumbs(add: link_to('Organizations', organizations_path)) %>
  <% update_breadcrumbs(
       add: link_to(@organization.name, organization_path(@organization))
     ) %>
  <% update_breadcrumbs(add: 'New Members') %>
<% else %>
  <% update_document_title(add: 'People') %>
  <% update_breadcrumbs(add: link_to('People', participants_path)) %>
  <% update_breadcrumbs(add: 'New Person') %>
<% end %>

<div class="content">
  <div>
    <% if can?(:create, @participant) %>
      <%- model_class = Participant -%>
      <div class="page-header">
        <h1
          ><%= t '.title',
                default: [:'helpers.titles.new', 'New %<model>s'],
                model: model_class.model_name.human %></h1
        >
      </div>
      <%= render 'new_participant_form' %>
    <% else %>
      <h3>You Aren't Authorized to See This Page</h3>
    <% end %> </div
  ><div class="sidebar"></div>
</div>
