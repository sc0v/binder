<%= form_with model: @shift_participant do |f| %>
  <%= f.label :query, 'Shift ID:' %>
  <%= f.text_field :shift_id, as: :hidden, input_html: { value: params[:shift_id] } %>
  <%= f.label :query, ' Person:' %>

  <% if @organization %>
    <%= f.collection_select :participant_id,
                            @organization.participants,
                            :id,
                            :name,
                            required: true %>
  <% else %>
    <%= f.collection_select :participant_id, Participant.all, :id, :name, required: true %>
  <% end %>

  <%= f.radio_button :clock_in_now, 'Clock In Now' %>
  <%= f.label :query, 'Clock In Now' %>
  <div class="cmu-button-note">
    <%= f.submit 'Submit', class: 'btn', data: { turbo: 'false' } %>
    <%# link_to t('.submit', defult: t('helpers.links.submit')), @shift_participant.shift, class: 'btn ghost' %>
    <%= link_to t('.cancel', default: t('helpers.links.cancel')),
                @shift_participant.shift,
                class: 'btn ghost' %>
  </div>
<% end %>
