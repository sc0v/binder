<%# THIS FORM IS CURRENTLY UNUSED,
USING new_shifts/_step_csv_upload and _step_repair.erb instead %>

<%= simple_form_for @shift do |f| %>
  <div class="form-inputs">
    <%= f.input :starts_at %>
    <%= f.input :ends_at %>
    <%= f.input :description %>
    <%= f.association :organization %>
    <%= f.association :shift_type %>
  </div>
  <div class="cmu-button-note">
    <%= f.button :submit, class: 'btn' %>
    <%= link_to t('.cancel', default: t('helpers.links.cancel')),
                @shift,
                class: 'btn ghost' %>
  </div>
<% end %>
