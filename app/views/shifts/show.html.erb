<div class="content wide">
  <div>
    <% if can?(:read, @shift) %>
      <%- model_class = Shift -%>
      <h1><%= @shift.shift_type.name %></h1>
      <dl class="cmu-split">
        <div>
          <dt><%= model_class.human_attribute_name(:capacity) %></dt>
          <dd><%= @shift.capacity.presence || 'N/A' %></dd>
          <dt><%= model_class.human_attribute_name(:description) %></dt>
          <dd><%= h @shift.description.presence || 'N/A' %></dd>
          <dt><%= model_class.human_attribute_name(:organization) %></dt>
          <dd
            ><%= if @shift.organization.present?
                  link_to(@shift.organization.name, @shift.organization)
                else
                  'N/A'
                end %></dd
          >
        </div>
        <div>
          <dt><%= model_class.human_attribute_name(:starts_at) %></dt>
          <dd><%= date_and_time(@shift.starts_at) %></dd>
          <dt><%= model_class.human_attribute_name(:ends_at) %></dt>
          <dd><%= date_and_time(@shift.ends_at) %></dd>
        </div>
      </dl>
      <div class="cmu-button-note">
        <%= link_to t('.back', default: t('helpers.links.back')),
                    shifts_path,
                    class: 'btn ghost' %>
        <% if can?(:update, @shift) %>
          <%= link_to t('.edit', default: t('helpers.links.edit')),
                      edit_shift_path(@shift),
                      class: 'btn' %>
        <% end %>
        <% if can?(:destroy, @shift) %>
          <%= button_to t('.destroy', default: t('helpers.links.destroy')),
                        shift_path(@shift),
                        method: :delete,
                        data: {
                          confirm:
                            t(
                              '.confirm',
                              default: t('helpers.links.confirm', default: 'Are you sure?')
                            )
                        },
                        class: 'btn' %>
        <% end %>
      </div>
    <% else %>
      <h3>You Aren't Authorized to See This Page</h3>
    <% end %>
  </div>
</div>
