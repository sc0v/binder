<% page ||= 'default' %>
<div class="table-scroll">
  <table class="alternate cmu-full">
    <thead>
      <tr>
        <th>Name</th>
        <th>Quantity</th>
        <th>Subtotal</th>
      </tr>
    </thead>
    <tbody>
      <%= render partial: 'store/items/cart_item', collection: items %>
      <%# Summary row %>
      <tr>
        <td><strong>Total</strong></td>
        <td><%= items.sum(&:quantity_purchased) %></td>
        <td
          ><%= number_to_currency(
                items.sum { |item| item.quantity_purchased * item.price_at_purchase }
              ) %></td
        >
      </tr>
    </tbody>
  </table>
</div>
<%= button_to 'Clear Cart',
              store_cart_clear_cart_path,
              method: :delete,
              class: 'cmu-link-button' %>
