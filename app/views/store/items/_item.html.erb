<div class="store-item aligncenter">
  <%= safe_image_tag "store_images/#{item.name}.png",
                     class: 'store-item-image',
                     alt: item.name %>
  <p><%= link_to item.name, item %></p>
  <p><%= number_to_currency item.price %></p>
  <%= link_to t('.add_to_cart', default: t('helpers.links.add_to_cart')),
              add_to_cart_store_item_path(item),
              class: 'btn small',
              data: {
                turbo_method: :post
              } %>
</div>
