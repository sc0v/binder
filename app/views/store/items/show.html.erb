<% update_document_title(add: @store_item.name.to_s) %>
<% update_breadcrumbs(add: link_to('Store', store_path)) %>
<% update_breadcrumbs(add: @store_item.name.to_s) %>

<div class="content">
  <div>
    <h1><%= @store_item.name %></h1>
    <p>
      <%= link_to safe_asset_path("store_images/#{@store_item.name}.png"), data: { cmu_zoom: true } do %>
        <%= safe_image_tag("store_images/#{@store_item.name}.png", alt: @store_item.name, size: '70x70') %>
      <% end %>
    </p>
    <br/>
    <dl>
      <dt>Price</dt>
      <dd><%= number_to_currency @store_item.price %></dd>
    </dl>
    <% if can?(:update, @store_item) %>
      <%= link_to t('.edit', default: t('helpers.links.edit')),
                  edit_store_item_path(@store_item), class: 'btn' %>
    <% end %>
    <% if can?(:destroy, @store_item) %>
      <%= link_to t('.destroy', default: t('helpers.links.destroy')),
                  store_item_path(@store_item),
                  data: {
                    turbo_confirm: 'Are you sure?',
                    turbo_method: 'delete'
                  },
                  class: 'btn' %>
    <% end %>
    <br/>
  </div>
</div>
