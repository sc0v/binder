<div class="content wide">
  <div>
    <% if can?(:read, Task) %>
      <%- model_class = Task -%>
      <div class="page-header">
        <h1>
          <%= t '.title', default: model_class.model_name.human.pluralize %>
        </h1>
      </div>
      <div class="row">
        <div>
          <form action="<%= tasks_path %>" method="get">
            <div class="cmu-button-note">
              <label for="task-filter">Filter by Task Completion</label>
              <select
                name="task_filter"
                id="task-filter"
                class="inline"
                onchange="this.form.submit()"
              >
                <option
                  value=""
                  <%= 'selected' if params[:task_filter].blank? %>
                  >All Tasks</option
                >
                <option
                  value="completed_tasks"
                  <%= 'selected' if params[:task_filter] == 'completed_tasks' %>
                  >Completed Tasks</option
                >
                <option
                  value="incomplete_tasks"
                  <%= 'selected' if params[:task_filter] == 'incomplete_tasks' %>
                  >Incomplete Tasks</option
                >
              </select>
            </div>
          </form>
        </div>
        <div>
          <% if can?(:create, Task) %>
            <div>
              <%= link_to t('.new', default: t('helpers.links.new_task')),
                          new_task_path,
                          class: 'btn' %>
            </div>
            <br />
          <% end %>
        </div>
      </div>
      <div class="table-scroll">
        <table class="alternate cmu-full">
          <thead>
            <tr>
              <th><%= model_class.human_attribute_name(:name) %></th>
              <th class="hidden-xs"
                ><%= model_class.human_attribute_name(:description) %></th
              >
              <th><%= model_class.human_attribute_name(:due_at) %></th>
              <% if can?(:update, Task) or can?(:destroy, Task) %>
                <th class="hidden-xs"
                  ><%= t '.actions', default: t('helpers.actions') %></th
                >
              <% end %>
            </tr>
          </thead>
          <tbody>
            <% @tasks.each do |task| %>
              <tr>
                <td><%= link_to task.name, task %></td>
                <td
                  class="hidden-xs"
                  style="word-wrap: break-word;max-width: 300px;"
                  ><%= task.description %></td
                >
                <td><%= date_and_time task.due_at %></td>
                <% if can?(:update, Task) or can?(:destroy, Task) %>
                  <td class="hidden-xs">
                    <% if can?(:update, task) %>
                      <% if !task.is_completed %>
                        <%= link_to t('.complete', default: t('helpers.links.complete')),
                                    complete_task_path(task),
                                    method: :post,
                                    class: 'btn small' %>
                      <% end %>
                      <%= link_to t('.edit', default: t('helpers.links.edit')),
                                  edit_task_path(task),
                                  class: 'btn small' %>
                    <% end %>
                    <% if can?(:destroy, task) %>
                      <%= link_to t('.destroy', default: t('helpers.links.destroy')),
                                  task_path(task),
                                  method: :delete,
                                  data: {
                                    confirm:
                                      t(
                                        '.confirm',
                                        default: t('helpers.links.confirm', default: 'Are you sure?')
                                      )
                                  },
                                  class: 'btn small' %>
                    <% end %>
                  </td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <h3>You Aren't Authorized to See This Page</h3>
    <% end %>
  </div>
</div>
