<% update_document_title(add: @tool_type.name.to_s) %>
<% update_breadcrumbs(add: link_to('Tool Types', tool_types_path)) %>
<% update_breadcrumbs(add: @tool_type.name.to_s) %>
<% nav(active: 'tools') %>

<div class="content">
  <div>
    <h1><%= @tool_type.name %></h1>
    <p>
      <%= link_to safe_asset_path("tool_images/#{@tool_type.name}.png"), data: { cmu_zoom: true } do %>
        <%= safe_image_tag("tool_images/#{@tool_type.name}.png", alt: @tool_type.name, size: '70x70') %>
      <% end %>
    </p>
    <br/>
    <% if can?(:update, @tool_type) %>
      <%= link_to t('.edit', default: t('helpers.links.edit')),
                  edit_tool_type_path(@tool_type), class: 'btn' %>
    <% end %>
    <% if can?(:destroy, @tool_type) %>
      <%= link_to t('.destroy', default: t('helpers.links.destroy')),
                  tool_type_path(@tool_type),
                  data: {
                    turbo_confirm: 'Are you sure?',
                    turbo_method: 'delete'
                  },
                  class: 'btn' %>
    <% end %>
    <br/>
  </div>
</div>
