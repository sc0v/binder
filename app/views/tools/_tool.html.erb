<tr class="<%= 'warning' if tool.checked_out? %>">
  <td><%= link_to tool.barcode, tool, class: 'btn small' %></td>
  <td><%= tool.name %></td>
  <td><%= tool.description %></td>
  <td>
    <%# add the image of the tool in its own column %>
    <% begin %>
    <%#= image_tag("tool_images/#{tool.name}.png", id: "tool-image-#{tool.name}", class: 'tool-image', data: { tool_name: tool.name, image_url: asset_path("tool_images/#{tool.name}.png") }, size: '70x70') %>
    <% rescue Propshaft::MissingAssetError %>
    <% end %>
  </td>
  <td><%= date_and_time(tool.checkouts.current.first.checked_out_at) if tool.checked_out? %></td>
  <td class="hidden-xs <%= 'hidden' if page == 'org' %>"><%= link_to tool.checkouts.current.first.organization.short_name, tool.checkouts.current.first.organization if tool.checked_out? %></td>
  <td class="visible-lg <%= 'visible-sm visible-md' if page == 'org' %>"><%= link_to tool.checkouts.current.first.participant.name, tool.checkouts.current.first.participant if tool.checked_out? && tool.checkouts.current.first.participant.present? %></td>
</tr>
