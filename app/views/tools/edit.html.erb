<% update_document_title(add: 'Tools') %>
<% update_breadcrumbs(add: link_to('Tools', tools_path)) %>
<% update_breadcrumbs(add: "#{@tool.name} #{@tool.barcode}") %>
<div class="content">
  <div>
    <% if can?(:update, @tool) %>
      <div class="page-header">
        <h1>Edit Tool</h1>
        <%= form_with model: @tool do |f| %>
          <%= f.label :tool_type_id, 'Tool Type' %>
          <%= f.collection_select(:tool_type_id, ToolType.all, :id, :name) %>
          <%= f.label :description, 'Description' %>
          <%= f.text_area :description, placeholder: 'Optional' %>
          <%= f.label :barcode, 'Barcode' %>
          <%= f.text_field :barcode %>
          <%= submit_tag 'Edit Tool' %>
        <% end %>
      </div>
    <% else %>
      <h3>You Aren't Authorized to See This Page</h3>
    <% end %>
  </div>
</div>
