<% update_document_title(add: 'Tools') %>
<% update_breadcrumbs(add: 'Tools') %>
<% content_for :head do %>
  <script></script>
<% end %>

<div class="content">
  <div>
    <h1>Tools</h1>
    <%= form_tag(tools_url, method: 'get') do %>
      <%= label_tag 'type', 'Equipment Type' %>
      <%= select_tag 'type',
                     options_for_select(
                       [%w[Tool tool], %w[Hardhat hardhat], %w[Radio radio]],
                       params[:type]
                     ),
                     onchange: 'this.form.submit()',
                     class: 'inline' %>
    <% end %>
    <%= data_table(
          id: 'tools-table',
          config: tools_table_config(@json_url),
          rows: @table_rows,
          noun: 'tool'
        ) %>
    <div>
      <% if can?(:create, Tool) and @organization.blank? %>
        <%= link_to t('.new', default: t('helpers.links.new')), new_tool_path, class: 'btn' %>
      <% end %>
    </div> </div
  ><div class="sidebar">
    <% if can?(:create, Checkout) %>
      <%= render 'tools/checkouts/sidebar' %>
    <% end %>
    <% if can?(:create, ToolType) %>
      <%= render 'tools/toToolTypes/sidebar' %>
    <% end %>
  </div>
</div>
