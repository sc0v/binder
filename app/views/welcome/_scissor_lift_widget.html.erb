<div class="queue-widget">
  <div class="queue-widget__header">
    <h1>Scissor Lift Queue</h1>
    <%= link_to 'See Details', scissor_lifts_path, class: 'btn small' %>
  </div>

  <p class="scissor-lift-available">
    <span class="scissor-lift-available__label">Available:</span>
    <% if available.any? %>
      <% available.each do |lift| %>
        <span class="scissor-lift-chip"><%= lift.name %></span>
      <% end %>
    <% else %>
      <span class="scissor-lift-available__empty">None available</span>
    <% end %>
  </p>

  <div class="queue-flow">
    <% if queue.any? %>
      <% queue.each do |entry| %>
        <div class="queue-chevron">
          <span class="queue-chevron__org">
            <%= entry.organization&.short_name %>
          </span>
        </div>
      <% end %>
      <div class="queue-chevron queue-chevron--placeholder"></div>
      <div class="queue-chevron queue-chevron--placeholder"></div>
    <% else %>
      <p class="queue-flow__empty">No one in the scissor lift queue.</p>
    <% end %>
  </div>
</div>
